# ==============================================================================
# English Speaking AI - Environment Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.
# In production, configure variables securely via your secret manager or runtime environment.
# ==============================================================================

# Server Configuration
PORT=
SPRING_PROFILES_ACTIVE=

# Local PostgreSQL Database (Docker Compose & Spring Boot)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Supabase Identity & Storage Configuration
# Used by Spring Boot backend for JWT validation (JWKS/issuer)
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI Provider Configuration
# Used by backend AI adapter to serve speech/conversation scenarios
GEMINI_API_KEY=
GEMINI_MODEL=
