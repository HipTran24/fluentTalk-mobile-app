# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Backend (Spring Boot / Maven / Toolchain)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.hprof

# Local environment files; only sanitized templates belong in Git.
.env
.env.*
**/.env
**/.env.*
*.env
!**/.env.example
!**/.env.*.example
!**/*.env.example

# Local application configuration (public project identifiers stay local too).
/config/*
!/config/*.example.json
!/config/*.env.example
!/config/README.md

# Signing material, provider credentials and machine-specific secrets.
*.pem
*.key
*.p12
*.pfx
*.p8
*.mobileprovision
*.provisionprofile
*.jks
*.keystore
**/key.properties
**/keystore.properties
**/credentials.json
**/.npmrc
**/.netrc
**/.pypirc
**/.docker/config.json
**/service-account*.json
**/service_account*.json
**/google-services.json
**/GoogleService-Info.plist
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/application-secrets.yml
**/application-secrets.yaml
**/application-secrets.properties

# Runtime output, database backups and local service state.
.run/
scripts/__pycache__/
backups/
dumps/
*.dump
*.backup
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
supabase/.temp/
supabase/.branches/
supabase/config.local.toml
.supabase/

# Local editor overrides (shared tasks and launch templates remain versioned).
.vscode/*.local.json
